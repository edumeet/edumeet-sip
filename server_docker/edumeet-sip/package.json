	"license": "MIT",
	"dependencies": {
		"debug": "^4.4.3",
  		"eslint": "^7.32.0",
  		"domready": "^1.0.8",
		"mediasoup-client": "3.15.6",
		"random-string": "^0.2.0",
		"react-scripts": "^4.0.1",
		"sdp-transform": "^2.14.0",
		"sip.js": "^0.15.11",
		"socket.io-client": "^2.5.0",
		"source-map-explorer": "^2.1.0"
	},
	"scripts": {
		"analyze-main": "source-map-explorer build/static/js/main.*",
		"analyze-chunk": "source-map-explorer build/static/js/2.*",
		"start": "HTTPS=true PORT=4443 react-scripts start",
		"build": "react-scripts --openssl-legacy-provider build && mkdir -p ../server/public && rm -rf ../server/public/* && cp -r build/* ../server/public/",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"test": "react-scripts test",
		"eject": "react-scripts eject"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie > 0",
		"not op_mini all"
	],
	"devDependencies": {
		"eslint-plugin-react": "^7.30.1"
	}
}
